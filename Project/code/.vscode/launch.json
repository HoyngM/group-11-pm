{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Synthetic log only (~1 min)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "args": ["--datasets", "synthetic"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. BPIC11 f1 quick look (2 repetitions, 20 itemsets)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "args": ["--datasets", "BPIC11_f1", "--n-repeats", "2", "--max-itemsets", "20"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Everything in config.yaml",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. Unit tests",
      "type": "debugpy", "request": "launch", "module": "pytest", "args": ["-v"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. Regenerate synthetic data and controls",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/generate_data.py",
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    }
  ]
}
