{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Whole pipeline, reproduces the reported results (20-25 min)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Synthetic log only, test cases (seconds)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "args": ["--datasets", "synthetic", "--evaluate-on", "test", "--output-directory", "results_quick"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. BPIC11 f1 quick look (2 repetitions, 30 itemsets)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "args": ["--datasets", "BPIC11_f1", "--repetitions", "2",
               "--max-itemsets", "30", "--evaluate-on", "test", "--output-directory", "results_quick"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. Comparison only (after a full run)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/main.py",
      "args": ["--steps", "compare"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. Unit tests",
      "type": "debugpy", "request": "launch", "module": "pytest", "args": ["-v"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    }
  ]
}
